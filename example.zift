server
  listen 127.0.0.1:2222
  host-key /tmp/zift_host_ed25519
  reload-interval 2s
  idle-timeout 5m
  max-connections 128
  max-unauth-connections 32
  log stderr
  # `virtual` (default in v0.3.0+) shows the partner their own user
  # name + a fixed group of "sftp" + policy-derived rwx bits. Set to
  # `reality` if you want the on-disk owner/group/mode to leak through
  # (rare; mostly useful for debugging).
  listing-mode virtual
  # When set, a user without an explicit `root` directive defaults
  # its root to `<partner-root>/<user-name>`. v0.7.0 — operators
  # pointing every partner at `/home/zift/<name>` no longer need to
  # repeat the path in every user block.
  partner-root /tmp/zift

user ally
  # `auth <value>` — v0.7.0 unified credential directive.
  #   - $argon2id...   ⇒ password (Argon2id PHC string)
  #   - /absolute/path ⇒ public-key file (operator-managed)
  # Multiple `auth /path/...` lines accumulate (multiple keys).
  # At most one `auth $...` line per user (single password slot).
  auth $argon2id$v=19$m=65536,t=3,p=4$example$replace-me
  # `partner-root` makes this user's root default to /tmp/zift/ally.
  # Override with `root /custom/path` if needed.
  # The four-verb model covers every SFTP wire op:
  #   read    = stat + readdir + download (`read` includes `list` since v0.4.0)
  #   add     = upload + mkdir + rename
  #   remove  = unlink + rmdir + clobber authority
  #   full    = read + add + remove (shorthand for "everything")
  #
  # Clobber rule (v0.4.0): any OPEN(write) on an existing file
  # requires `remove` permission on that path. So `add`-without-
  # `remove` lets the partner CREATE new files but never modify or
  # destroy existing ones. Same applies to rename-over-existing.
  allow / read
  allow /pending read add remove
  allow /archive read
  # `**` crosses path boundaries (gitignore-style); `*` does not.
  # `**.exe` denies executables anywhere under the partner root;
  # `**/.ssh/**` denies anything inside a `.ssh` dir at any depth.
  deny **.exe
  deny **/.ssh/**
