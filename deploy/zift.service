[Unit]
Description=Zift SFTP Server
Documentation=https://github.com/shreeve/zift
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=zift
Group=zift

ExecStart=/usr/local/bin/zift serve /etc/zift/zift.conf

Restart=on-failure
RestartSec=5

# Hardening: restrict the process to the minimum it needs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true

# Only the partner roots, the config, and the audit log need to be writable.
# Adjust these paths to match your layout.
ReadWritePaths=/zfs/sftp /var/log/zift

# The host key and config are read-only after startup.
ReadOnlyPaths=/etc/zift

# Resource limits: bound Argon2id memory pressure from auth storms.
# Argon2id worst-case memory at the upper envelope is 256 MiB per
# in-flight verification. With MemoryMax=4G the host can safely run
# ~14 concurrent password verifications before the cgroup OOMs Zift,
# which is the right order of magnitude for a 16-connection partner
# install. Pair this with `max-connections` in zift.conf — keep the
# product `max-connections * 256 MiB` strictly below MemoryMax. For
# larger deployments, lower the Argon2id `m` parameter or raise
# MemoryMax (and ensure the host has the headroom).
LimitNOFILE=4096
MemoryMax=4G

UMask=0027

[Install]
WantedBy=multi-user.target
