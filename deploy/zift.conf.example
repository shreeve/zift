# Zift config — production starter for the /home/zift/ deploy layout.
#
# Install path: /home/zift/zift.conf
# Owner/mode:   root:zift, 0640
#               (root-owned so a daemon compromise cannot self-modify
#                the config; group `zift` reads only. Edit via
#                `sudoedit /home/zift/zift.conf`.)
#
# Edit before going live:
#   1. Provision each partner with one or more credentials via `auth`:
#        - `auth $argon2id$...`     — password (run `printf 'pw\n' |
#          zift hash-password` to generate the PHC string; paste the
#          full `$argon2id$...` line here). At most one per user.
#        - `auth /home/zift/keys/<partner>.pub` — public key in an
#          operator-managed file (chmod 0640 root:zift). Multiple
#          `auth /path` lines accumulate — handy for key rotation.
#   2. The partner's username and allow/deny rules to match the
#      workflow you've agreed with that partner. With `partner-root`
#      below set to `/home/zift`, the user's `root` defaults to
#      `/home/zift/<user>`; override per-user with an explicit
#      `root /...` line if needed.
#   3. `listen` IP/port if you want to bind somewhere other than
#      0.0.0.0:2222 (e.g. an internal interface only).
#   4. `max-connections` — keep `max-connections * 256 MiB ≤ MemoryMax`
#      from the systemd unit (default 4 GiB → ~14 concurrent verifications).
#
# After saving, validate before letting the running server pick it up:
#
#   sudo -u zift zift validate /home/zift/zift.conf
#
# Then either wait `reload-interval` (2 s default) for the mtime-based
# reload, or force it: `sudo systemctl kill -s HUP zift`.

server
  listen 0.0.0.0:2222
  host-key /home/zift/host_ed25519
  idle-timeout 5m
  max-connections 14
  max-unauth-connections 4
  reload-interval 2s
  log /home/zift/audit.jsonl
  # `virtual` (the v0.3.0+ default) shows the partner their own user
  # name + a fixed group of "sftp" + policy-derived rwx bits. Set to
  # `reality` if you want the on-disk owner/group/mode to leak through
  # (rare; mostly useful for debugging).
  listing-mode virtual
  # v0.6.0+: mode applied to atomically-published partner uploads.
  # Default 0o660 (group `zift` rw, world none) matches the deploy
  # layout where operators in group `zift` can manage partner data
  # via the host. Allowed values: 0o600, 0o640, 0o660.
  publish-mode 0o660
  # v0.6.0+: mode applied to directories alice creates via SFTP
  # MKDIR. Default 0o2770 (setgid + group rwx + world none) so
  # subdirectories inherit `group=zift`. Allowed: 0o2700, 0o2750,
  # 0o2770.
  mkdir-mode 0o2770
  # v0.7.0+: when set, every user without an explicit `root`
  # directive defaults to `<partner-root>/<user-name>` —
  # `/home/zift/alice` for the user block below. Operators
  # pointing every partner at `/home/zift/...` no longer have to
  # repeat the path in every user. The directive itself takes any
  # absolute path; per-user overrides via an explicit `root` line
  # are still honored.
  partner-root /home/zift

user alice
  # `auth <value>` — v0.7.0 unified credential directive.
  # Replace ONE of the two examples below (or use both for password
  # + key parallel auth). At most one `auth $...` (password) per
  # user; `auth /path` lines accumulate for multiple authorized keys.
  auth $argon2id$v=19$m=65536,t=3,p=1$REPLACE-WITH-REAL-SALT$REPLACE-WITH-REAL-HASH
  # auth /home/zift/keys/alice.pub
  # `partner-root` above makes this user's root default to
  # `/home/zift/alice`. If you want a different layout, add an
  # explicit `root /...` line here.
  # The four-verb model covers every SFTP wire op:
  #   read    = stat + readdir + download (`read` includes `list` since v0.4.0)
  #   add     = upload + mkdir + rename
  #   remove  = unlink + rmdir + clobber authority
  #   full    = read + add + remove (shorthand for "everything")
  #
  # Clobber rule (v0.4.0): any OPEN(write) on an existing file requires
  # `remove` on that path. So `add` without `remove` lets the partner
  # CREATE new files / new names but never modify or destroy existing
  # entries. Same rule applies to rename-over-existing.
  allow /inbox  read add
  allow /outbox read
  # `**` crosses path boundaries (gitignore-style); `*` does not.
  # `**.exe`     → deny executables anywhere under the partner root.
  # `**/.ssh/**` → deny anything inside a `.ssh` dir at any depth.
  deny **.exe
  deny **/.ssh/**
