[Unit]
Description=Zift SFTP Server
Documentation=https://github.com/shreeve/zift
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zift
Group=zift

ExecStart=/usr/local/bin/zift serve /home/zift/zift.conf

# Reload validates first: a bad config fails `systemctl reload` loudly
# and the daemon is never signalled (docs/operate.md, "Reload").
ExecReload=/usr/local/bin/zift validate /home/zift/zift.conf
ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=5

# Keep above `shutdown-grace` (default 30s) so the drain can finish.
TimeoutStopSec=60

# One thread per connection: keep above max-connections.
TasksMax=512

# Hardening: the minimum a TCP daemon doing libssh and file I/O needs.
NoNewPrivileges=true
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RemoveIPC=true

# Do NOT add RestrictSUIDSGID: it fails every setgid MKDIR (the default
# mkdir-mode 0o2770). NoNewPrivileges and NoExecPaths already cover it.

# Filesystem visibility. ProtectProc and ProcSubset need Linux 5.8+ and
# systemd 247+.
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
# Of /home, only /home/zift is visible. Another layout: see
# docs/operate.md, "Alternative Layouts".
ProtectHome=tmpfs
BindPaths=/home/zift
ProtectProc=invisible
ProcSubset=pid

# Kernel-config surface.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true

# Memory & exec.
MemoryDenyWriteExecute=true

# No capabilities. A port below 1024 needs CAP_NET_BIND_SERVICE: see
# the drop-in in docs/operate.md, "Set Up The Host".
CapabilityBoundingSet=
AmbientCapabilities=

# TCP over IPv4 and IPv6 only.
RestrictAddressFamilies=AF_INET AF_INET6

# Syscalls. A filtered call kills the process (SIGSYS), the loud default.
# The last line re-allows raising the soft fd limit up to LimitNOFILE,
# which needs no privilege and which ~@resources would otherwise take.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallFilter=~@resources
SystemCallFilter=setrlimit prlimit64
SystemCallArchitectures=native

KeyringMode=private

# The only writable tree, and nothing in it may be executed by this
# service. Another layout needs these edited (docs/operate.md).
ReadWritePaths=/home/zift
NoExecPaths=/home/zift

# The defaults (max-connections 128) need 33,856 fds; password checks
# peak at 512 MiB plus 256 KiB per session (docs/operate.md). Raise LimitNOFILE with max-connections (docs/operate.md).
LimitNOFILE=65536
MemoryMax=4G

UMask=0027

[Install]
WantedBy=multi-user.target
