[Unit]
Description=Zift SFTP Server
Documentation=https://github.com/shreeve/zift
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zift
Group=zift

ExecStart=/usr/local/bin/zift serve /home/zift/zift.conf
# Zift reloads its config on SIGHUP, so `systemctl reload zift` should
# deliver one. Without ExecReload the verb fails outright and operators
# fall back to `systemctl kill -s HUP`.
ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=5

# Bound the drain: keep systemd's stop timeout above the daemon's own
# `shutdown-grace` (default 30s) so graceful drain + force-close can run
# to completion before systemd SIGKILLs. Raise this if you raise
# shutdown-grace.
TimeoutStopSec=60

# Thread-per-connection: cap total tasks so a connection storm can't
# spawn unbounded threads. Keep comfortably above max-connections.
TasksMax=512

# Hardening: restrict the process to the minimum it needs. The set
# below is the union of well-tested directives that work for a long-
# running TCP daemon doing libssh + filesystem I/O. Each directive
# restricts a specific kernel surface; together they cover privilege,
# namespace, kernel-config, IPC, address-family, syscall, capability,
# and /dev visibility.

# Privilege & namespace fences.
NoNewPrivileges=true
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RemoveIPC=true

# RestrictSUIDSGID is deliberately NOT set, and must not be re-added.
#
# It blocks the setgid bit, and every value `mkdir-mode` accepts
# (0o2700, 0o2750, 0o2770) carries setgid. With it enabled, MKDIR fails
# for every partner under every policy -- the audit log shows
# `"operation":"mkdir","result":"failed","detail":"createDir failed"`,
# i.e. the policy check passed and the syscall was refused. Verified by
# running the same mkdir as `zift` with and without the restriction.
#
# The setgid bit is load-bearing, not incidental: it is what keeps new
# directories in group `zift` so host-side operators retain access
# without re-chowning (see docs/operate.md, "Operator Access").
#
# What RestrictSUIDSGID would defend against -- this process creating a
# setuid/setgid binary for later escalation -- is already covered:
# NoNewPrivileges=true stops this process gaining privileges, and
# NoExecPaths=/home/zift means nothing in the only writable tree can be
# executed in the first place.

# Filesystem visibility.
# `PrivateDevices=true` exposes only /dev/null, /dev/zero, /dev/full,
# /dev/random, /dev/urandom, /dev/tty — enough for libssh's RNG init
# without exposing the rest of /dev.
# `ProtectProc=invisible` makes /proc show only this service's PIDs.
# `ProcSubset=pid` hides /proc/<pid>/{net,sys,...}, leaving only PID
# metadata. Both directives require Linux 5.8+ / systemd 247+.
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
# /home/zift/ is the entire deploy tree (config + host key + partner
# data + audit log). `ProtectHome=tmpfs` replaces /home/ with an empty
# tmpfs in the unit's mount namespace, hiding every other user's home
# directory from zift. `BindPaths=/home/zift` bind-mounts just zift's
# own home back over that tmpfs at the same path. Net effect: zift
# can see /home/zift/ and nothing else under /home/.
ProtectHome=tmpfs
BindPaths=/home/zift
ProtectProc=invisible
ProcSubset=pid

# Kernel-config surface.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true

# Memory & exec.
MemoryDenyWriteExecute=true

# Capabilities. Zift runs as `zift:zift` and never needs root caps.
# An empty bounding set is the strongest possible filter.
CapabilityBoundingSet=
AmbientCapabilities=

# Address families. Zift speaks SFTP over TCP only — IPv4 and IPv6.
# AF_UNIX is not used (no local-socket protocol). AF_NETLINK is not
# used (no kernel-event subscription). Refusing them removes the
# corresponding kernel parsers from the attack surface.
RestrictAddressFamilies=AF_INET AF_INET6

# System-call surface. `@system-service` is systemd's curated baseline
# for ordinary daemons; the additional `~@privileged ~@resources`
# subtractions block setuid/setgid/setpgid/sched_setaffinity/etc.
# that Zift never invokes. `SystemCallArchitectures=native` blocks
# the 32-bit syscall ABI on x86_64 hosts (a frequent confused-deputy
# vector).
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallFilter=~@resources
SystemCallArchitectures=native

# Kernel keyring. Zift does not use the keyring; isolate it.
KeyringMode=private

# The single deploy tree under /home/zift contains the config, host
# key, partner roots (each user's `root` lives at /home/zift/<user>/),
# and the audit log. ProtectSystem=strict makes the rest of the
# filesystem read-only.
ReadWritePaths=/home/zift
# Partners upload arbitrary bytes into /home/zift. MemoryDenyWriteExecute
# blocks W^X inside this process, but does not stop something else on the
# host from execve()ing an uploaded file. Mark the whole writable tree
# non-executable so an uploaded payload cannot be run from here.
NoExecPaths=/home/zift

# Resource limits: bound Argon2id memory pressure from auth storms.
# passhash credentials use fixed argon2id params (64 MiB per verification).
# With MemoryMax=4G the host can safely run many concurrent verifies;
# still pair with `max-connections` / `max-unauth-connections` so a
# handshake storm cannot pin every worker on KDF work.
LimitNOFILE=4096
MemoryMax=4G

UMask=0027

[Install]
WantedBy=multi-user.target
